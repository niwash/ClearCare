# Copy to terraform.tfvars and replace the placeholders. The real file is ignored by git
# through infra/aws/.gitignore, because the prefix names this account's login host.
#
# The prefix is the first label of the managed login domain:
#   https://<domain_prefix>.auth.<region>.amazoncognito.com
# It is global across all AWS accounts and cannot be renamed after the pool is created
# without replacing the domain, so choose it once.

# The account that owns the pool. The provider refuses to create anything anywhere else.
account_id = "123456789012"

domain_prefix = "clearcare-prod-example"

# The address visitors use. No trailing slash: Cognito matches the registered URLs exactly.
web_origin = "https://clearcare.example.com"

# Sending domain for account mail, and the From line visitors see.
ses_domain         = "clearcare.example.com"
from_email_address = "ClearCare <no-reply@clearcare.example.com>"
