[Unit]
Description=ClearCare: snapshot the HIQA registers
Documentation=https://github.com/niwash/ClearCare/tree/main/infra/systemd
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# After every run, including failed ones, copy to object storage, so files
# stored before a failure still leave the VM, and load the register. The
# loader takes the newest successful register snapshot from the manifest and
# exits 0 if it is already published, so running it after a failed run is
# safe, and a day on which only the Section 64 register fails still loads
# the register.
OnSuccess=clearcare-raw-upload.service clearcare-register-load.service
OnFailure=clearcare-raw-upload.service clearcare-register-load.service

[Service]
Type=oneshot
# Runs as uid 1001 (the VM's ubuntu user), which owns /opt/clearcare/data.
ExecStart=/usr/bin/docker run --rm --name clearcare-register-snapshots \
    --user 1001:1001 \
    --volume /opt/clearcare/data:/data \
    clearcare-pipeline:latest clearcare_pipeline.snapshots --data-dir /data
TimeoutStartSec=30min
