# Settings for the local database in compose.yaml. Copy this file to .env.
# These values are for local development only. Never use them in a deployment.

# The postgres superuser.
POSTGRES_PASSWORD=local-only-postgres

# The login roles that infra/postgres/roles.sql creates.
CLEARCARE_MIGRATOR_PASSWORD=local-only-migrator
CLEARCARE_PIPELINE_PASSWORD=local-only-pipeline
CLEARCARE_API_PASSWORD=local-only-api

# The port on 127.0.0.1. Change it if another PostgreSQL already uses 5432.
CLEARCARE_DB_PORT=5432
