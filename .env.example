# Settings for compose.yaml. Copy this file to .env.
# These values are for local development only. Never use them in a deployment.

# The postgres superuser.
POSTGRES_PASSWORD=local-only-postgres

# The login roles that infra/postgres/roles.sql creates.
CLEARCARE_MIGRATOR_PASSWORD=local-only-migrator
CLEARCARE_PIPELINE_PASSWORD=local-only-pipeline
CLEARCARE_API_PASSWORD=local-only-api

# The port on 127.0.0.1. Change it if another PostgreSQL already uses 5432.
CLEARCARE_DB_PORT=5432

# The API's port on 127.0.0.1.
CLEARCARE_API_PORT=8080

# What the pipeline downloads from HIQA: off, a county as the register spells it (e.g. Kildare), or all.
CLEARCARE_CRAWL=off

# Where the pipeline keeps raw files, manifests and schedule-state.json.
CLEARCARE_DATA_DIR=./data

# The user the pipeline runs as. On Linux, use the data directory's owner (id -u, id -g).
CLEARCARE_PIPELINE_UID=1000
CLEARCARE_PIPELINE_GID=1000

# The bucket the pipeline copies raw files to. Leave all five empty to skip the upload.
CLEARCARE_S3_ENDPOINT=
CLEARCARE_S3_REGION=
CLEARCARE_S3_BUCKET=
CLEARCARE_S3_ACCESS_KEY_ID=
CLEARCARE_S3_SECRET_ACCESS_KEY=

# The key for the amenities extractor (Research/Data Extraction/extractor.py). Not used by compose.
OPENAI_API_KEY=
