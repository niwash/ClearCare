# Public accounts are optional: the site renders without these, and the account
# pages explain that sign-in is not configured. Copy to .env.local and fill in
# the values from `terraform -chdir=infra/aws/cognito/development output`.

# Signing key for the encrypted session cookie. Generate with
# `openssl rand -base64 33`; never reuse the development value in production.
AUTH_SECRET=

# Cognito app client ("client_id" and "client_secret" outputs).
AUTH_COGNITO_ID=
AUTH_COGNITO_SECRET=

# Cognito OIDC issuer ("issuer" output).
AUTH_COGNITO_ISSUER=https://cognito-idp.eu-north-1.amazonaws.com/<pool-id>

# Managed login domain ("domain" output). Create account enters Cognito here,
# so it is required.
COGNITO_DOMAIN=https://<domain-prefix>.auth.eu-north-1.amazoncognito.com

# The token this server and the API share for a signed-in visitor's saved search
# (ADR-0025) and for the points of the search page's map (ADR-0029). Generate
# with `openssl rand -base64 33` and set the same value in the API's
# environment. Left out, the save controls and the map never appear and the
# search page works exactly as it did before.
SITE_TOKEN=

# The browser key for Google's place suggestions in the search page's
# "Town, area or Eircode" box (Maps JavaScript and Places, limited by Google to
# the site's own origins). Read on the server for each request and handed to the
# page, so it is not NEXT_PUBLIC_: the Docker image is built once and must not
# carry it. Left out, the box is a plain text box and the rest of search works.
# The search page's map uses the same key.
GOOGLE_MAPS_BROWSER_KEY=

# The map ID for the search page's map, from the same Google Cloud project: its
# pins are advanced markers, which need one. Read on the server like the key.
# DEMO_MAP_ID will do for local work. Left out, the page shows the list alone.
GOOGLE_MAPS_MAP_ID=
