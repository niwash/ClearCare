# Public accounts are optional: the site renders without these, and the account
# pages explain that sign-in is not configured. Copy to .env.local and fill in
# the values from `terraform -chdir=infra/aws/cognito/development output`.

# Signing key for the encrypted session cookie. Generate with
# `openssl rand -base64 33`; never reuse the development value in production.
AUTH_SECRET=

# Cognito app client ("client_id" and "client_secret" outputs).
AUTH_COGNITO_ID=
AUTH_COGNITO_SECRET=

# Cognito OIDC issuer ("issuer" output).
AUTH_COGNITO_ISSUER=https://cognito-idp.eu-north-1.amazonaws.com/<pool-id>

# The managed login domain ("domain" output) is not read yet. It becomes
# required when the sign-out route leaves for Cognito:
# COGNITO_DOMAIN=https://<domain-prefix>.auth.eu-north-1.amazoncognito.com
